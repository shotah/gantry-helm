# Copy to .env for a local sideload. Never commit .env.
# Precedence: process env > .env > empty Info.plist keys > simulator defaults.
# HELM_GOOGLE_WEB_CLIENT_ID = pendant’s Web OAuth client (the token aud).
# Also create a separate iOS OAuth client (bundle com.gantree.helm, no redirect).
HELM_MAILBOX_ORIGIN=http://127.0.0.1:3000
HELM_GOOGLE_WEB_CLIENT_ID=
HELM_GOOGLE_IOS_CLIENT_ID=
