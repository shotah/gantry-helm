# Copy to .env for a local sideload. Never commit .env.
# Same Worker URL + Web client id as gantry-cab (CAB_MAILBOX_ORIGIN /
# CAB_GOOGLE_WEB_CLIENT_ID). The iOS client is new — Google derives the
# URL scheme from it (reversed client id). No SHA-1 on iOS.
HELM_MAILBOX_ORIGIN=http://127.0.0.1:3000
HELM_GOOGLE_WEB_CLIENT_ID=
HELM_GOOGLE_IOS_CLIENT_ID=
